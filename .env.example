# Anthropic (Reasoning tier)
ANTHROPIC_API_KEY=

# OpenAI (Bulk fallback + Embedding)
OPENAI_API_KEY=

# OpenRouter (OpenAI-compatible live runner)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SOLOOS_OPENROUTER_MODEL=openai/gpt-5-mini

# Telegram bot (Command Deck primary channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CEO_CHAT_ID=

# Discord (secondary — optional)
DISCORD_BOT_TOKEN=

# Google Workspace (already configured via ~/.hermes/google_token.json for dogfood)
GOOGLE_TOKEN_PATH=~/.hermes/google_token.json

# Data paths
SOLOOS_DATA_DIR=./data
SOLOOS_DB_PATH=./data/soloos.sqlite

# LLM Tier Models
SOLOOS_MODEL_REASONING=claude-sonnet-4-5
SOLOOS_MODEL_BULK=claude-haiku-4-5
SOLOOS_MODEL_EMBEDDING=text-embedding-3-small

# Runtime
SOLOOS_TIMEZONE=Asia/Seoul
SOLOOS_LOG_LEVEL=INFO

# Mission Control web deployment
# Local dogfood can leave this empty: Next.js API routes call `uv run soloos ...`.
# Serverless hosts such as Vercel must point to a persistent SoloOS HTTP service.
SOLOOS_MISSION_CONTROL_URL=
SOLOOS_MISSION_CONTROL_TOKEN=
# Optional inbound API/site guard. Required when SOLOOS_MISSION_CONTROL_URL is set.
# For browser UI, prefer Basic auth so same-origin fetches keep working.
SOLOOS_WEB_BASIC_USER=ceo
SOLOOS_WEB_BASIC_PASSWORD=
# For direct API clients, Bearer or x-soloos-web-token is also accepted.
SOLOOS_WEB_API_TOKEN=
SOLOOS_REQUIRE_WEB_AUTH=
# Set to remote on non-Vercel serverless platforms to disable local CLI execution.
SOLOOS_MISSION_CONTROL_MODE=
